SECRET_KEY=sua_chave_super_secreta_aqui
ALGORITHM=HS256
REDIS_URL=redis://redis_cache:6379
CACHE_TTL_SECONDS=60

# --- Logs ---
# DEBUG mostra também as decisões internas do agente.
LOG_LEVEL=INFO
# "text" para ler no terminal, "json" para agregador de logs.
LOG_FORMAT=text
# Nível das libs de terceiro. Em INFO, o agno loga "Found 0 documents" a cada
# busca no knowledge e afoga o log de verdade.
LOG_LEVEL_LIBS=WARNING
# Quantos caracteres da mensagem do usuário vão para o log. 0 grava só o tamanho.
LOG_MESSAGE_PREVIEW_CHARS=120

# --- Agente de IA (Agno) ---
# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Usada tanto pelo modelo principal quanto pelo embedder do knowledge base.
GOOGLE_API_KEY=
# Chave da Groq (https://console.groq.com/keys). Modelo de fallback.
GROQ_API_KEY=

# Postgres com pgvector (serviço postgres_ai do docker-compose).
# Rodando fora do Docker, use: postgresql+psycopg://agno:agno@localhost:5433/agno_ai
AI_DATABASE_URL=postgresql+psycopg://agno:agno@postgres_ai:5432/agno_ai

GEMINI_MODEL_ID=gemini-3.5-flash
GROQ_MODEL_ID=openai/gpt-oss-120b
GEMINI_EMBEDDER_ID=gemini-embedding-001
GEMINI_EMBEDDER_DIMENSIONS=1536

# Quantas interações anteriores entram no contexto de cada mensagem.
AI_HISTORY_RUNS=5
# Quanto tempo (s) o Gemini fica em quarentena depois de estourar cota,
# período em que todas as requisições vão direto para a Groq.
AI_FALLBACK_COOLDOWN_SECONDS=300
